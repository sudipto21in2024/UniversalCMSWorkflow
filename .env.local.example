# Figma Access Configuration
# Generate a Personal Access Token in Figma (Settings -> Security -> Personal Access Tokens)
# Ensure it has 'File content' and 'File variables' read permissions.
FIGMA_ACCESS_TOKEN=figd_your_token_here

# Optional: Vision Sub-agent LLM API Key (OpenAI / Gemini endpoint)
LLM_API_KEY=
VISION_MODEL=gpt-4o-mini

# Optional: Storybook base URL (default: http://localhost:6006)
STORYBOOK_URL=http://localhost:6006
